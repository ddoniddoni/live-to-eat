{
  "name": "live-to-eat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.20.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev:mobile": "npm run dev --workspace=@live-to-eat/mobile",
    "dev:share": "npm run dev --workspace=@live-to-eat/share",
    "lint": "oxlint apps packages scripts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:db": "supabase test db",
    "test:e2e": "npm run test:e2e --workspace=@live-to-eat/mobile --",
    "build:share": "npm run build --workspace=@live-to-eat/share",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run check:docs && npm run check:locales",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "check:locales": "node scripts/check-locales.mjs"
  },
  "devDependencies": {
    "eas-cli": "23.2.0",
    "expo-doctor": "1.20.4",
    "firebase-tools": "15.29.0",
    "oxlint": "1.82.0",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
