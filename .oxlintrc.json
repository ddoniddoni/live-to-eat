{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/style-prop-object": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/.expo/**", "**/node_modules/**"]
}
