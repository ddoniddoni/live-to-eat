{
  "name": "@live-to-eat/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "../../modules"
    }
  },
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "oxlint src app.config.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "test:e2e": "maestro test .maestro",
    "preview:web": "EXPO_PUBLIC_AUTH_PREVIEW=true expo start --web",
    "test:unit": "vitest run src/features/notebook/demoStorage.test.ts"
  },
  "dependencies": {
    "@live-to-eat/domain": "0.1.0",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.102.8",
    "expo": "57.0.21",
    "expo-apple-authentication": "57.0.1",
    "expo-auth-session": "57.0.11",
    "expo-build-properties": "57.0.17",
    "expo-constants": "57.0.17",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.18",
    "expo-file-system": "57.0.7",
    "expo-linking": "57.0.9",
    "expo-localization": "57.0.1",
    "expo-location": "57.0.16",
    "expo-router": "57.0.20",
    "expo-secure-store": "57.0.3",
    "expo-sharing": "57.0.18",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "expo-web-browser": "57.0.2",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.13",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.2"
