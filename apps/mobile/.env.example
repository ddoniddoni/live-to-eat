# Provisional development identifiers. Confirm production IDs before store setup.
APP_VARIANT=development
APP_IOS_BUNDLE_ID=com.ddoni.livetoeat.dev
APP_ANDROID_PACKAGE=com.ddoni.livetoeat.dev
APP_SCHEME=live-to-eat-dev

# Public client configuration. Authorization still depends on Supabase RLS.
# In Supabase Auth, allow the development app's OAuth redirect and the two
# email-link redirects. The email links include a PKCE flow id query value:
# live-to-eat-dev://auth/oauth?sb_flow_id=*
# live-to-eat-dev://auth/confirm?sb_flow_id=*
# live-to-eat-dev://auth/recovery?sb_flow_id=*
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Local UI review only. This skips all Supabase session, OAuth, and data calls.
# Keep false for every shared build and release.
EXPO_PUBLIC_AUTH_PREVIEW=false
EXPO_PUBLIC_SHARE_ORIGIN=https://example.invalid

# Owner-approved public help/policy pages. Leave blank until published.
# No credentials, private form prefill, or session tokens in these URLs.
# Each language needs its own URL; there is no silent language fallback.
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_SUPPORT_URL_EN=
EXPO_PUBLIC_TERMS_URL_KO=
EXPO_PUBLIC_TERMS_URL_EN=
EXPO_PUBLIC_TERMS_VERSION=
EXPO_PUBLIC_TERMS_EFFECTIVE_DATE=
EXPO_PUBLIC_PRIVACY_URL_KO=
EXPO_PUBLIC_PRIVACY_URL_EN=
EXPO_PUBLIC_PRIVACY_VERSION=
EXPO_PUBLIC_PRIVACY_EFFECTIVE_DATE=
# Policy dates: YYYY-MM-DD. URL + version + date are required to expose a link.
# These are display metadata only. Auth consent versions remain a separate release task.

# Restricted native map keys. Do not use the server-side Places key here.
GOOGLE_MAPS_IOS_KEY=YOUR_RESTRICTED_IOS_MAPS_KEY
GOOGLE_MAPS_ANDROID_KEY=YOUR_RESTRICTED_ANDROID_MAPS_KEY
