# Provisional development identifiers. Confirm production IDs before store setup.
APP_VARIANT=development
APP_IOS_BUNDLE_ID=com.ddoni.livetoeat.dev
APP_ANDROID_PACKAGE=com.ddoni.livetoeat.dev
APP_SCHEME=live-to-eat-dev

# Public client configuration. Authorization still depends on Supabase RLS.
# In Supabase Auth, allow this exact redirect for the development app:
# live-to-eat-dev://auth/callback
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Local UI review only. This skips all Supabase session, OAuth, and data calls.
# Keep false for every shared build and release.
EXPO_PUBLIC_AUTH_PREVIEW=false
EXPO_PUBLIC_SHARE_ORIGIN=https://example.invalid

# Restricted native map keys. Do not use the server-side Places key here.
GOOGLE_MAPS_IOS_KEY=YOUR_RESTRICTED_IOS_MAPS_KEY
GOOGLE_MAPS_ANDROID_KEY=YOUR_RESTRICTED_ANDROID_MAPS_KEY
